# Copie para server/.env (ignorado pelo git) e preencha com os valores reais.
# O PHP não lê este arquivo sozinho: exporte as variáveis no ambiente do servidor.

# Banco: mysql em produção, sqlite nos testes.
DB_DRIVER=mysql
DB_HOST=
DB_NAME=zerafilas
DB_USER=
DB_PASS=

# Origem única permitida para CORS (ex.: https://zerafilas.exemplo.com).
# Vazia = nenhum cabeçalho CORS.
CORS_ORIGIN=

# Proxies confiáveis (IPs ou faixas CIDR, separados por vírgula). Só atrás deles a API usa
# o X-Forwarded-For para achar o IP do cliente no limite de tentativas. Vazia = nenhum.
TRUSTED_PROXIES=

# Limite de tentativas (inteiros positivos; vazio usa o padrão).
# Erros na janela de RATE_LIMIT_JANELA_MIN minutos; os cadastros têm janela própria.
# Padrões: login por e-mail 5, login por IP 20, senha por conta 5, janela 15 min,
# cadastro por IP 5 em 60 min.
RATE_LIMIT_LOGIN_EMAIL=
RATE_LIMIT_LOGIN_IP=
RATE_LIMIT_SENHA_CONTA=
RATE_LIMIT_JANELA_MIN=
RATE_LIMIT_CADASTRO_IP=
RATE_LIMIT_CADASTRO_JANELA_MIN=
