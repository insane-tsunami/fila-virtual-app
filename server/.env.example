# Copie para server/.env (ignorado pelo git) e preencha com os valores reais.
# O PHP não lê este arquivo sozinho: exporte as variáveis no ambiente do servidor.

# Banco: mysql em produção, sqlite nos testes.
DB_DRIVER=mysql
DB_HOST=
DB_NAME=zerafilas
DB_USER=
DB_PASS=

# Origem única permitida para CORS (ex.: https://zerafilas.exemplo.com).
# Vazia = nenhum cabeçalho CORS.
CORS_ORIGIN=

# Endereço público do front, sem barra final: base do link de redefinição de senha.
# Sem ele o link não é montado e nenhum e-mail sai.
APP_URL=

# E-mail. MAIL_DRIVER: desligado (padrão: não envia, só avisa no log), log (grava a
# mensagem inteira, com o link secreto, no log: SÓ desenvolvimento e testes) ou smtp.
# MAIL_DSN é segredo (ex.: smtp://usuario:senha@smtp.exemplo.com:587); nunca commite.
MAIL_DRIVER=
MAIL_DSN=
MAIL_FROM=

# Proxies confiáveis (IPs ou faixas CIDR, separados por vírgula). Só atrás deles a API usa
# o X-Forwarded-For para achar o IP do cliente no limite de tentativas. Vazia = nenhum.
TRUSTED_PROXIES=

# Limite de tentativas (inteiros positivos; vazio usa o padrão).
# Erros na janela de RATE_LIMIT_JANELA_MIN minutos; os cadastros têm janela própria.
# Padrões: login por e-mail 5, login por IP 20, senha por conta 5, janela 15 min,
# cadastro por IP 5 em 60 min. "Esqueci a senha": pedidos por e-mail 3 e por IP 10 em 60 min
# (RATE_LIMIT_ESQUECI_JANELA_MIN), tokens inválidos por IP 20 na janela de 15 min.
# Confirmação do e-mail: envios por conta 3 em 60 min (RATE_LIMIT_CONFIRMACAO_JANELA_MIN),
# tokens inválidos por IP 20 na janela de 15 min.
RATE_LIMIT_LOGIN_EMAIL=
RATE_LIMIT_LOGIN_IP=
RATE_LIMIT_SENHA_CONTA=
RATE_LIMIT_JANELA_MIN=
RATE_LIMIT_CADASTRO_IP=
RATE_LIMIT_CADASTRO_JANELA_MIN=
RATE_LIMIT_ESQUECI_EMAIL=
RATE_LIMIT_ESQUECI_IP=
RATE_LIMIT_ESQUECI_JANELA_MIN=
RATE_LIMIT_REDEFINIR_IP=
RATE_LIMIT_CONFIRMACAO_CONTA=
RATE_LIMIT_CONFIRMACAO_JANELA_MIN=
RATE_LIMIT_CONFIRMAR_IP=
