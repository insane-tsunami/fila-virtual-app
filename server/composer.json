{
    "name": "zerafilas/server",
    "description": "API da fila virtual do ZeraFilas",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^8.0",
        "illuminate/database": "^13.0",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "authors": [
        {
            "name": "Fabio Suenaga",
            "email": "insane.tsunami@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Controllers\\": "app/controllers/",
            "Middleware\\": "app/middleware/",
            "Models\\": "app/models/",
            "Services\\": "app/services/",
            "Support\\": "app/support/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "@php bin/migrate"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
