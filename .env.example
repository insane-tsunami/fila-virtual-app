# URL base da API do ZeraFilas (sem barra no final), gravada no pacote na hora do build.
# Vazia = mesma origem do site (use quando um proxy encaminha /api para o servidor PHP).
# Em produção use HTTPS: um site em HTTPS não consegue chamar uma API em HTTP.
# Nunca coloque a X-API-Key aqui: tudo o que começa com REACT_APP_ vai para o navegador.
REACT_APP_API_URL=http://localhost:8080
